# Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/smarttender
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=YOUR_DB_PASSWORD
PGDATABASE=smarttender
PGSSL=false

# JWT Authentication
JWT_SECRET=YOUR_LONG_RANDOM_SECRET_HERE

# Application URL
APP_URL=http://localhost:3000

# Email Configuration
# NOTE FOR RENDER DEPLOYMENTS:
# Render Free Tier blocks outbound SMTP ports 25, 465, and 587.
# To send real emails from Render, use an HTTPS API (Port 443 is unblocked):
# Option A: Resend API (Free 100 emails/day, 3000/month at resend.com)
# RESEND_API_KEY=re_1234567890abcdef
#
# Option B: Brevo API (Free 300 emails/day at brevo.com)
# BREVO_API_KEY=xkeysib-1234567890abcdef
#
# Option C: Standard SMTP (Localhost or VPS where ports 587/465 are open)
EMAIL_SERVICE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD
EMAIL_FROM=SmartTender <your-email@gmail.com>

# ==============================================================================
# Payment Gateway Configuration (Razorpay Integration)
# ==============================================================================
# Payment Provider: razorpay
PAYMENT_PROVIDER=razorpay

# Payment Mode: 'test' (Sandbox) or 'live' (Production)
# NOTE: In Live mode, RAZORPAY_KEY_ID must begin with 'rzp_live_'
PAYMENT_MODE=test

# Razorpay API Credentials (Leave empty until generated in Razorpay Dashboard)
# Server-side secrets are strictly kept confidential and never sent to frontend.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay Webhook Secret (Configured in Razorpay Dashboard -> Settings -> Webhooks)
# Webhook URL: https://<your-render-domain>/api/payments/webhook
# Events: payment.captured, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=

# Payment Fee Fallbacks (in Paise: 1 INR = 100 Paise)
# Overridden by specific tender record emd_amount / tender_fee in database
# Default Tender Fee: ₹1,000.00 (100000 paise)
TENDER_FEE_PAISE=100000
# Default EMD Fee: ₹50,000.00 (5000000 paise)
EMD_AMOUNT_PAISE=5000000